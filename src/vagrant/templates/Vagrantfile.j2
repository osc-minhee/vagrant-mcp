# -*- mode: ruby -*-
# mcp_example 이 생성한 파일입니다 (resource: {{ resource_id }}). 직접 수정하면 다음 변경 시 덮어써집니다.
Vagrant.configure("2") do |config|
  config.vm.box = "{{ box }}"
{% if box_version %}
  config.vm.box_version = "{{ box_version }}"
{% endif %}
  config.vm.hostname = "{{ name }}"
  config.vm.define "{{ name }}"

  # MCP Server(Ansible)가 접속할 수 있도록 브리지 네트워크에 고정 IP 를 준다.
{% if bridge %}
  config.vm.network "public_network", ip: "{{ ip }}", bridge: "{{ bridge }}"
{% else %}
  config.vm.network "public_network", ip: "{{ ip }}"
{% endif %}

  config.vm.provider "virtualbox" do |vb|
    vb.name = "{{ resource_id }}"
    vb.cpus = {{ cpu }}
    vb.memory = {{ memory }}
    vb.customize ["modifyvm", :id, "--description", "managed-by=mcp_example purpose={{ purpose }}"]
  end

  # Ansible 접속용 공개키 등록 (최초 vagrant up 때만 실행)
  config.vm.provision "shell", inline: <<-SHELL
    install -d -m 700 -o vagrant -g vagrant /home/vagrant/.ssh
    touch /home/vagrant/.ssh/authorized_keys
{% for key in ssh_pubkeys %}
    grep -qxF '{{ key }}' /home/vagrant/.ssh/authorized_keys || echo '{{ key }}' >> /home/vagrant/.ssh/authorized_keys
{% endfor %}
    chown vagrant:vagrant /home/vagrant/.ssh/authorized_keys
    chmod 600 /home/vagrant/.ssh/authorized_keys
  SHELL
end
