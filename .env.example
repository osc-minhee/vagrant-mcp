# ==========================================
# vagrant-provisioner 환경변수 예시
# 이 파일을 secrets/.env 로 복사한 뒤 값을 채운다. (docker-compose 가 ./secrets/.env 를 읽는다)
#   mkdir -p secrets/.ssh && cp .env.example secrets/.env
# 값을 바꾼 뒤에는 컨테이너를 재생성해야 반영된다: docker compose up -d --force-recreate
# ==========================================

# ------------------------------------------
# Vagrant 호스트 (방법 A 또는 B 중 하나)
# ------------------------------------------

# [방법 A] 여러 호스트: VAGRANT_HOSTS (JSON 배열). 반드시 한 줄로 쓰고 전체를 작은따옴표로 감싼다.
#   name        (필수) 호스트 이름. vg_create_vm 의 host 로 쓰인다 (대소문자 구분 없음)
#   address     (필수) 호스트 IP/도메인. local 이면 MCP Server 와 같은 머신에서 실행
#   user        SSH 계정 (기본 vagrant)
#   port        SSH 포트 (기본 22)
#   workdir     VM 폴더를 만들 절대경로 (기본 ~/vagrant-mcp). VM 은 {workdir}/{project}/vg-<이름> 에 만들어진다
#   default_project  vg_create_vm 에서 project 를 비웠을 때 쓸 프로젝트 폴더 (예: openwebui). 없으면 {workdir}/vg-<이름>
#               (영문/숫자/._- 만, 한 단계 폴더 이름. 전체 기본값은 아래 VAGRANT_DEFAULT_PROJECT)
#   ip_ranges   VM 에 줄 고정 IP 대역 목록. "10.0.0.60-89" / "10.0.0.60-10.0.0.89" / "10.0.0.60"
#               (시작 IP 까지 전체를 쓴다. 호스트끼리 겹치지 않게)
#   scan_root   IP 를 고를 때 이 폴더 아래 Vagrantfile 의 IP 를 사용 중으로 본다 (기본: workdir). 그 호스트만 검색한다
#   bridge      브리지할 호스트 NIC 이름. 비우면 vagrant up 이 NIC 를 물어보다 실패할 수 있으니 지정한다
#   ssh_key     이 호스트용 개인키 경로 (컨테이너 안 경로. 기본: VAGRANT_SSH_KEY 또는 /app/secrets/.ssh/host_key)
#   ssh_password  키 대신 비밀번호로 접속할 때
# 호스트 기록이 없는 기존 VM 은 IP 가 속한 ip_ranges 의 호스트에 있는 것으로 본다 (정할 수 없으면 변경/삭제하지 않는다).
# 호스트가 1대면 vg_create_vm 에서 host 를 비워도 되고, 2대 이상이면 host 를 지정해야 한다.
# VM 이름은 호스트와 상관없이 전체에서 유일해야 한다.
#
# VAGRANT_HOSTS='[{"name":"host-a","address":"192.168.0.10","user":"oscka","workdir":"/home/oscka/server-workspace","ip_ranges":["192.168.0.60-89"],"bridge":"eno1"},{"name":"host-b","address":"192.168.0.11","user":"oscka","workdir":"/home/oscka/server-workspace","ip_ranges":["192.168.0.90-119"],"bridge":"enp5s0"}]'

# [방법 B] 호스트 1대: 아래 변수 (VAGRANT_HOSTS 가 없을 때만 쓰인다. 호스트 이름은 default)
VAGRANT_HOST="192.168.0.10"
VAGRANT_SSH_USER="os"
VAGRANT_SSH_PORT=22
VAGRANT_WORKDIR="/home/"
VAGRANT_IP_RANGE="192.168.0.60-89"
VAGRANT_BRIDGE="eno1"
# VAGRANT_SCAN_ROOT="/home/oscka/"   # 기본: VAGRANT_WORKDIR

# 모든 호스트의 기본 프로젝트 폴더 (호스트별 default_project 가 있으면 그것이 우선). VM 은 {workdir}/{프로젝트}/vg-<이름> 에 만들어진다.
# vg_create_vm 에서 사용자가 project 를 말하면 그 값을 쓰고, 말하지 않으면 이 기본값을 쓴다. 이미 만든 VM 의 경로는 바뀌지 않는다.
# VAGRANT_DEFAULT_PROJECT="openwebui"

# ------------------------------------------
# SSH 인증 (모든 호스트 공통. 호스트별 ssh_key / ssh_password 로 덮어쓸 수 있다)
# ------------------------------------------
# 키는 secrets/.ssh/host_key 에 두면 아래 설정 없이 사용된다 (공개키는 각 호스트 계정의 ~/.ssh/authorized_keys 에 등록)
# VAGRANT_SSH_KEY="/app/secrets/.ssh/host_key"
# VAGRANT_SSH_PASSWORD=""
# VAGRANT_SSH_TIMEOUT=10
# VAGRANT_SSH_STRICT_HOST_KEY=false

# ------------------------------------------
# VM 설정 (모든 호스트 공통)
# ------------------------------------------
# 이미지(OS)는 vg_create_vm 의 image 로 고른다 (ubuntu-22.04 기본, rocky-8, rocky-9). box/버전은 서버 코드에 고정.
# (VAGRANT_BOX / VAGRANT_BOX_VERSION 은 더 이상 쓰지 않는다)
# vagrant 명령 최대 대기(초). box 를 처음 받으면 오래 걸린다
# VAGRANT_TIMEOUT=1800
# 호스트마다 동시에 실행할 vagrant 명령 수
# VAGRANT_MAX_PARALLEL=2

# 생성 전 호스트 자원 확인 (느슨한 기준). 부족하면 vg_create_vm 이 이유와 가능한 사양을 알려주고 거절한다.
#   메모리: 가용 메모리(MemAvailable) >= 요청 사양(small 2GiB, medium 4GiB, large 8GiB) + 예비
#   디스크: workdir 의 여유 >= 최소 여유.  CPU 는 보지 않는다. 실행 중 VM 의 할당 합계(오버커밋)도 따지지 않는다.
# VAGRANT_RESOURCE_CHECK=true          # false 면 확인하지 않는다
# VAGRANT_HOST_MEM_RESERVE_MB=512      # 호스트에 남겨 둘 예비 메모리(MiB)
# VAGRANT_MIN_DISK_FREE_MB=5120        # 최소 디스크 여유(MiB)
# true 면 VM 생성 후 Ansible 환경 구성을 건너뛴다
# VAGRANT_SKIP_ANSIBLE=false

# VM 의 SSH 비밀번호 로그인 (내부망 테스트/시연용, Ansible 이 설정). 브리지 네트워크라 같은 LAN 에서 접속 가능하다.
# VAGRANT_VM_PASSWORD_AUTH=true        # false 면 켜지 않는다 (키 로그인만)
# VAGRANT_VM_PASSWORD="vagrant"        # vagrant 계정 비밀번호. 기본값은 널리 알려져 있으니 바꾸기를 권한다

# 생성/변경/삭제가 끝나면 웹훅으로 알린다 (본문 {"content": "..."}, 내부 정보는 가린다). 비우면 알리지 않는다.
# Open WebUI 채널 수신 웹훅: 채널 > Edit channel > Webhooks > New Webhook > Copy URL
# URL 에 토큰이 들어 있으니 비밀값으로 다룬다.
# VAGRANT_NOTIFY_WEBHOOK="http://open-webui:8080/api/v1/channels/webhooks/<id>/<token>"
# VAGRANT_NOTIFY_ON=all                # error 면 실패만 알린다

# ------------------------------------------
# 서버 (컨테이너에서는 기본값 사용)
# ------------------------------------------
# SERVER_HOST="0.0.0.0"
# SERVER_PORT=8000
# DB_PATH="./data/infra_state.db"
